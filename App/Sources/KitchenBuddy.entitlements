<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud Documents (container iCloud.net.puddleglum.kitchenbuddy) is
	     added back in M8 with the backup mirror. Assigning the container to
	     the App ID is a one-time click in the developer portal that neither
	     CI's API key nor xcodebuild can do; see tasks.md 2.3.1. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.net.puddleglum.kitchenbuddy</string>
	</array>
</dict>
</plist>
